# Reality Lab Chatbot — environment template
# Copy to `.env` in the repo root on the deploy server and fill in real values.
# `.env` is gitignored — never commit real keys.

# OpenAI credentials (chatbot backend)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.5
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional overrides
# RAG_DIR=/absolute/path/to/hierarchical_rag
