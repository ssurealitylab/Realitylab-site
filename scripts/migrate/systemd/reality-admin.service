[Unit]
Description=Reality Lab Admin CMS
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=/home/%i/Realitylab-site/admin_cms
EnvironmentFile=-/home/%i/Realitylab-site/.env
ExecStart=/home/%i/Realitylab-site/.venv/bin/python3 /home/%i/Realitylab-site/admin_cms/admin_server.py --port 4010
Restart=always
RestartSec=5
StandardOutput=append:/home/%i/Realitylab-site/ai_server/admin.service.log
StandardError=append:/home/%i/Realitylab-site/ai_server/admin.service.log

[Install]
WantedBy=multi-user.target
